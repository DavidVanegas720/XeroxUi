{
  "name": "xerox-ui",
  "version": "0.1.0",
  "description": "Design system de componentes Vue 3 sobre shadcn-vue.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/xerox-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "build:js": "vite build",
    "build:css": "tailwindcss -i src/styles/dist.css -o dist/xerox-ui.css --minify && tailwindcss -i src/styles/tokens-only.css -o dist/tokens.css --minify",
    "build:assets": "node scripts/finalize-dist.mjs",
    "build": "npm run build:js && npm run build:css && npm run build:assets",
    "typecheck": "vue-tsc --noEmit",
    "contrast": "node scripts/check-contrast.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node scripts/generate-tokens.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.46.0",
    "@vueuse/core": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.460.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10",
    "wawoff2": "^2.0.1"
  }
}
