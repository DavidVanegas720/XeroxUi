{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": [
    "dist",
    "node_modules",
    "storybook-static",
    "src/**/*.stories.ts",
    "src/foundations/**",
    ".storybook/**"
  ]
}
